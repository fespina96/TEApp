<?xml version="1.0" encoding="utf-8"?>
<!-- Fondo del selector de padres supervisados. Lleva la flecha dibujada: sin ella
     el campo se leía como una etiqueta y no como algo desplegable. -->
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">

    <item>
        <shape android:shape="rectangle">
            <solid android:color="#EEF7FB" />
            <stroke android:width="1dp" android:color="@color/primary_dark" />
            <corners android:radius="8dp" />
        </shape>
    </item>

    <item
        android:drawable="@drawable/ic_arrow_down"
        android:gravity="center_vertical|end"
        android:end="12dp"
        android:width="22dp"
        android:height="22dp" />

</layer-list>
