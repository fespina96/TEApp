<?xml version="1.0" encoding="utf-8"?>
<androidx.cardview.widget.CardView
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/card"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_margin="6dp"
    app:cardCornerRadius="12dp"
    app:cardElevation="2dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:gravity="center"
        android:padding="12dp">

        <!-- Pictograma propio o, si no tiene, el icono de la actividad -->
        <FrameLayout
            android:layout_width="@dimen/pictogram_size"
            android:layout_height="@dimen/pictogram_size">

            <TextView
                android:id="@+id/tv_icono"
                style="@style/IconoMaterial"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:background="@drawable/circle_avatar"
                android:textSize="26sp" />

            <ImageView
                android:id="@+id/img_pictogram"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:scaleType="centerCrop"
                android:contentDescription="Pictograma"
                android:visibility="gone" />

        </FrameLayout>

        <!-- Nombre -->
        <TextView
            android:id="@+id/tv_name"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:textSize="14sp"
            android:textStyle="bold"
            android:textColor="@color/on_primary"
            android:gravity="center"
            android:layout_marginTop="6dp" />

        <!-- Categoría -->
        <TextView
            android:id="@+id/tv_category"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:textSize="11sp"
            android:textColor="@color/text_secondary"
            android:gravity="center" />

        <TextView
            android:id="@+id/tv_description"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:textSize="11sp"
            android:textColor="@color/text_secondary"
            android:gravity="center"
            android:maxLines="2"
            android:ellipsize="end"
            android:layout_marginTop="3dp"
            android:visibility="gone" />

        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:layout_marginTop="6dp">

            <ImageView
                android:layout_width="14dp"
                android:layout_height="14dp"
                android:src="@drawable/ic_list"
                android:contentDescription="Pasos"
                android:layout_marginEnd="3dp" />

            <TextView
                android:id="@+id/tv_steps"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:textSize="11sp"
                android:textColor="@color/text_secondary"
                android:text="Sin pasos" />

        </LinearLayout>

        <!-- Distintivo de actividad del sistema: un tilde suelto no se entendía -->
        <TextView
            android:id="@+id/iv_predefined"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="6dp"
            android:paddingStart="8dp"
            android:paddingEnd="8dp"
            android:paddingTop="2dp"
            android:paddingBottom="2dp"
            android:text="@string/del_sistema"
            android:textSize="10sp"
            android:textAllCaps="true"
            android:textStyle="bold"
            android:textColor="@color/text_secondary"
            android:background="@drawable/bg_pill_tab_container"
            android:visibility="gone" />

    </LinearLayout>

    <!-- Marcada, en la esquina y por encima del contenido -->
    <TextView
        android:id="@+id/iv_selected"
        style="@style/IconoMaterial"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="top|end"
        android:layout_margin="6dp"
        android:text="check_circle"
        android:textSize="22sp"
        android:textColor="@color/success_green"
        android:contentDescription="Seleccionada"
        android:visibility="gone" />

</androidx.cardview.widget.CardView>
