<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="@color/background">

    <com.google.android.material.tabs.TabLayout
        android:id="@+id/tab_layout"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="@color/primary"
        app:tabTextColor="@color/on_primary"
        app:tabSelectedTextColor="@color/on_primary"
        app:tabIndicatorColor="@color/on_primary"
        app:tabMode="scrollable" />

    <androidx.swiperefreshlayout.widget.SwipeRefreshLayout
        android:id="@+id/swipe_refresh"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1">

        <androidx.viewpager2.widget.ViewPager2
            android:id="@+id/view_pager"
            android:layout_width="match_parent"
            android:layout_height="match_parent" />

    </androidx.swiperefreshlayout.widget.SwipeRefreshLayout>

    <!-- Bottom toolbar -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:background="@color/primary"
        android:elevation="4dp"
        android:padding="8dp"
        android:gravity="center_vertical"
        android:clipToPadding="false"
        android:clipChildren="false">

        <!-- Sólidos y no contorneados: sobre la barra celeste el contorno casi no
             se veía. El de reinicio además llevaba sólo el glifo ↺, sin decir
             qué hacía. -->
        <Button
            android:id="@+id/btn_modo_nino"
            android:layout_width="0dp"
            android:layout_height="46dp"
            android:layout_weight="1"
            android:layout_marginEnd="6dp"
            android:text="@string/modo_participante"
            android:textSize="12sp"
            android:letterSpacing="0"
            android:textAllCaps="false"
            style="@style/Widget.MaterialComponents.Button"
            app:backgroundTint="@color/surface"
            android:textColor="@color/on_primary" />

        <Button
            android:id="@+id/btn_reset"
            android:layout_width="wrap_content"
            android:layout_height="46dp"
            android:layout_marginEnd="6dp"
            android:minWidth="0dp"
            android:paddingStart="14dp"
            android:paddingEnd="14dp"
            android:text="@string/reiniciar_semana_corto"
            android:textSize="12sp"
            android:letterSpacing="0"
            android:textAllCaps="false"
            style="@style/Widget.MaterialComponents.Button"
            app:backgroundTint="@color/surface"
            android:textColor="@color/on_primary" />

        <com.google.android.material.floatingactionbutton.FloatingActionButton
            android:id="@+id/fab_agregar"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:src="@drawable/ic_add"
            android:contentDescription="Agregar"
            app:backgroundTint="@color/secondary"
            app:fabSize="mini" />

    </LinearLayout>

</LinearLayout>
