<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/background">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="20dp">

        <!-- Nombre -->
        <com.google.android.material.textfield.TextInputLayout
            android:id="@+id/til_nombre"
            style="@style/Widget.MaterialComponents.TextInputLayout.OutlinedBox"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:hint="Nombre de la actividad"
            android:layout_marginBottom="12dp"
            app:hintTextColor="@color/text_input_hint"
            app:boxStrokeColor="@color/text_input_stroke"
            app:boxBackgroundColor="#EEF7FB">
            <com.google.android.material.textfield.TextInputEditText
                android:id="@+id/et_nombre"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:textColor="@color/on_primary"
                android:inputType="textCapSentences" />
        </com.google.android.material.textfield.TextInputLayout>

        <!-- Descripción -->
        <com.google.android.material.textfield.TextInputLayout
            android:id="@+id/til_descripcion"
            style="@style/Widget.MaterialComponents.TextInputLayout.OutlinedBox"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:hint="@string/descripcion"
            android:layout_marginBottom="12dp"
            app:hintTextColor="@color/text_input_hint"
            app:boxStrokeColor="@color/text_input_stroke"
            app:boxBackgroundColor="#EEF7FB">
            <com.google.android.material.textfield.TextInputEditText
                android:id="@+id/et_descripcion"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:textColor="@color/on_primary"
                android:inputType="textMultiLine"
                android:minLines="2" />
        </com.google.android.material.textfield.TextInputLayout>

        <!-- Categoría -->
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/categoria"
            android:textSize="12sp"
            android:textColor="@color/text_input_hint"
            android:layout_marginStart="4dp"
            android:layout_marginBottom="2dp" />

        <Spinner
            android:id="@+id/spinner_categoria"
            android:layout_width="match_parent"
            android:layout_height="48dp"
            android:layout_marginBottom="12dp"
            android:background="@drawable/spinner_background" />

        <!-- Duración -->
        <com.google.android.material.textfield.TextInputLayout
            android:id="@+id/til_duracion"
            style="@style/Widget.MaterialComponents.TextInputLayout.OutlinedBox"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:hint="@string/duracion_min"
            android:layout_marginBottom="12dp"
            app:hintTextColor="@color/text_input_hint"
            app:boxStrokeColor="@color/text_input_stroke"
            app:boxBackgroundColor="#EEF7FB">
            <com.google.android.material.textfield.TextInputEditText
                android:id="@+id/et_duracion"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:textColor="@color/on_primary"
                android:inputType="number" />
        </com.google.android.material.textfield.TextInputLayout>

        <!-- Pausable -->
        <com.google.android.material.switchmaterial.SwitchMaterial
            android:id="@+id/switch_pausable"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/pausable"
            android:textColor="@color/on_primary"
            android:checked="true"
            android:layout_marginBottom="16dp" />

        <!-- Pictograma ARASAAC -->
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Pictograma ARASAAC"
            android:textSize="14sp"
            android:textStyle="bold"
            android:textColor="@color/on_primary"
            android:layout_marginBottom="8dp" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:layout_marginBottom="8dp">

            <com.google.android.material.textfield.TextInputLayout
                android:id="@+id/til_arasaac"
                style="@style/Widget.MaterialComponents.TextInputLayout.OutlinedBox"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:hint="@string/buscar_pictograma"
                android:layout_marginEnd="8dp"
                app:hintTextColor="@color/text_input_hint"
                app:boxStrokeColor="@color/text_input_stroke"
                app:boxBackgroundColor="#EEF7FB">
                <com.google.android.material.textfield.TextInputEditText
                    android:id="@+id/et_buscar_arasaac"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:textColor="@color/on_primary"
                    android:imeOptions="actionSearch"
                    android:inputType="text" />
            </com.google.android.material.textfield.TextInputLayout>

            <Button
                android:id="@+id/btn_buscar"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/buscar"
                style="@style/Widget.TEApp.Button" />

        </LinearLayout>

        <!-- Pictograma seleccionado -->
        <LinearLayout
            android:id="@+id/layout_pictograma_seleccionado"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:visibility="gone"
            android:layout_marginBottom="8dp">
            <ImageView
                android:id="@+id/img_pictograma_seleccionado"
                android:layout_width="64dp"
                android:layout_height="64dp"
                android:layout_marginEnd="12dp"
                android:scaleType="centerCrop"
                android:contentDescription="Pictograma seleccionado" />
            <Button
                android:id="@+id/btn_quitar_pictograma"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Quitar"
                style="@style/Widget.MaterialComponents.Button.TextButton"
                android:textColor="@color/text_secondary" />
        </LinearLayout>

        <!-- ProgressBar búsqueda -->
        <ProgressBar
            android:id="@+id/progress_arasaac"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="center"
            android:visibility="gone" />

        <!-- Resultados ARASAAC -->
        <androidx.recyclerview.widget.RecyclerView
            android:id="@+id/rv_arasaac"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:nestedScrollingEnabled="false"
            android:layout_marginBottom="16dp" />

        <!-- Botón guardar -->
        <Button
            android:id="@+id/btn_guardar"
            android:layout_width="match_parent"
            android:layout_height="52dp"
            android:text="@string/guardar"
            style="@style/Widget.TEApp.Button" />

        <ProgressBar
            android:id="@+id/progress_bar"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="center"
            android:layout_marginTop="8dp"
            android:visibility="gone" />

    </LinearLayout>
</ScrollView>
