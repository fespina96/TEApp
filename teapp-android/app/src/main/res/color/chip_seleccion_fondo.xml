<?xml version="1.0" encoding="utf-8"?>
<!-- Fondo del chip segun este marcado: gris cuando no lo esta, para que la
     seleccion se distinga de un vistazo. -->
<selector xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:color="@color/primary" android:state_checked="true" />
    <item android:color="@color/chip_no_seleccionado" />
</selector>
